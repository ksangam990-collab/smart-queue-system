# ── Slotly Backend — Environment Variables ───────────────────────────────────
# Copy this file to .env and fill in the values.
# NEVER commit .env to the repository.

# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── MongoDB ─────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/slotly?retryWrites=true&w=majority

# ── JWT ─────────────────────────────────────────────────────────────────────
# Use a random string of at least 32 characters for JWT_SECRET
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-random-32-char-secret
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7       # days (must be a plain integer)

# ── Frontend URL (used in CORS, Socket.io, and email links) ─────────────────
# Development:  http://localhost:5173
# Production:   https://your-vercel-app.vercel.app
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@yourdomain.com
SUPPORT_EMAIL=support@yourdomain.com   # optional; falls back to EMAIL_FROM

# ── Cloudinary (avatar uploads) ──────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
