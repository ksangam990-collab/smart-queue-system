# ── Slotly Frontend — Environment Variables ──────────────────────────────────
# Copy this file to .env.local and fill in the values.
# NEVER commit .env or .env.local to the repository.
#
# For Vercel deployment: set these in the Vercel project dashboard under
# Settings → Environment Variables.

# Base URL of the backend API (no trailing slash)
# Development:  http://localhost:5000/api
# Production:   https://your-render-api.onrender.com/api
VITE_API_URL=http://localhost:5000/api
